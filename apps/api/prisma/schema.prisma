generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  passwordHash       String
  name               String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  projects           Project[]
  subscription       Subscription?
  creditTransactions CreditTransaction[]
  payments           Payment[]
}

model Plan {
  id                  String         @id @default(cuid())
  key                 String         @unique
  name                String
  priceCents          Int?
  monthlyCredits      Int?
  customDomainAllowed Boolean        @default(false)
  priorityGeneration  Boolean        @default(false)
  teamWorkspace       Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  subscriptions       Subscription[]
  payments            Payment[]
}

model Subscription {
  id                    String              @id @default(cuid())
  userId                String              @unique
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId                String
  plan                  Plan                @relation(fields: [planId], references: [id])
  status                String              @default("active")
  creditsRemaining      Int
  creditsUsedThisPeriod Int                 @default(0)
  currentPeriodStart    DateTime            @default(now())
  currentPeriodEnd      DateTime
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  creditTransactions    CreditTransaction[]

  @@index([planId])
}

model CreditTransaction {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId   String?
  subscription     Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  type             String
  amount           Int
  reason           String
  relatedProjectId String?
  relatedProject   Project?      @relation(fields: [relatedProjectId], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())

  @@index([userId, createdAt])
  @@index([relatedProjectId])
}

model CreditCost {
  id        String   @id @default(cuid())
  action    String   @unique
  credits   Int
  updatedAt DateTime @updatedAt
}

model CreditPack {
  id         String    @id @default(cuid())
  key        String    @unique
  name       String
  credits    Int
  priceCents Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  payments   Payment[]
}

model Payment {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind            String      @default("plan")
  planId          String?
  plan            Plan?       @relation(fields: [planId], references: [id])
  creditPackId    String?
  creditPack      CreditPack? @relation(fields: [creditPackId], references: [id])
  projectId       String?
  project         Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  reference       String      @unique
  paynowReference String?
  pollUrl         String
  amountCents     Int
  status          String      @default("Created")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
  @@index([planId])
  @@index([creditPackId])
  @@index([projectId])
}

model Project {
  id                 String              @id @default(cuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  type               String
  data               String              @default("{}")
  hostingStatus      String              @default("active")
  hostingExpiresAt   DateTime?
  domainType         String?
  domain             String?             @unique
  domainStatus       String?
  domainError        String?
  domainVerifiedAt   DateTime?
  assets             Asset[]
  creditTransactions CreditTransaction[]
  payments           Payment[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([userId])
  @@index([hostingStatus, hostingExpiresAt])
}

model Asset {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  filename  String
  mimeType  String
  path      String
  createdAt DateTime @default(now())
}
